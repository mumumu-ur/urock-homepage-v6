# Public site URL (used for canonical/hreflang/sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form email delivery (Resend HTTP API). If unset, submissions are logged only.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Cloudflare Turnstile (spam protection). If unset, captcha check is skipped.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Content source: "local" (default) or "cms" (future headless CMS)
CONTENT_SOURCE=local
